GRAPH_BACKEND=neo4j        # sqlite | neo4j
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Meta Model API (OpenAI-compatible). The key comes from the Meta Model API console (API keys). Models: muse-spark-1.3, -1.2, -1.1
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
# Muse Spark thinks at high effort by default (~30 s for a small question); low or minimal answers in a few seconds.
META_REASONING_EFFORT=low
# Optional: a different model for the independent checks (judge + blind probe), so the drafter does not check
# itself. Base URL and key default to the ones above.
META_JUDGE_MODEL=
META_JUDGE_BASE_URL=
META_JUDGE_API_KEY=
# Outside evidence from Wikidata for claims the graph does not hold (sends claim names to wikidata.org). 0 = off.
WIKIDATA_LOOKUP=1
# Also check facts the graph supplies against Wikidata (a stored value Wikidata contradicts is not served as verified)
GRAPH_CROSSCHECK=1
# Plots for works the graph has no events for are read from the work's Wikipedia article and checked against it.
WIKIPEDIA_LOOKUP=1
# With no source for a plot, the model may say what it remembers, labelled unverified (low confidence). 0 = decline.
PLOT_MEMORY_FALLBACK=1
# Evidence from the model API's own web search for what the graph, Wikidata and Wikipedia cannot settle. The cited pages
# are fetched by the app and only verbatim quotes count. ~10-17 s and ~10k tokens per question that needs it. 0 = off.
WEB_SEARCH=1
# Tavily search API (tavily.com): a second web search for that evidence, better at new and niche pages (books, pop
# culture) and at pages built with JavaScript. Off when empty. Costs Tavily credits (basic: 1 per question that needs it).
TAVILY_API_KEY=
TAVILY_DEPTH=basic

# LLM-proposed relation rules need approval. Set e.g. 0.95 to auto-apply very confident ones; empty = always manual.
RULE_AUTO_THRESHOLD=
# Extracted facts below this confidence go to the review queue instead of the graph.
MIN_TRIPLE_CONFIDENCE=0.6

# Safety (app/safety.py). Without ADMIN_TOKEN, admin writes work only from this machine.
ADMIN_TOKEN=
RATE_LIMIT_PER_MIN=30        # chat questions per IP per minute; 0 = off
MAX_QUESTION_CHARS=2000
TRUSTED_PROXY_HOPS=1         # proxies that append to X-Forwarded-For; 0 if the app is exposed directly
TURNS_RETENTION_DAYS=90      # chat turns (stored redacted) older than this are deleted; 0 keeps them
