GRAPH_BACKEND=neo4j        # sqlite | neo4j
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Meta API (OpenAI-compatible)
META_API_KEY=
META_BASE_URL=
META_MODEL=
# Optional: a different model for the independent checks (judge + blind probe), so the drafter does not check
# itself. Base URL and key default to the ones above.
META_JUDGE_MODEL=
META_JUDGE_BASE_URL=
META_JUDGE_API_KEY=
# Outside evidence from Wikidata for claims the graph does not hold (sends claim names to wikidata.org). 0 = off.
WIKIDATA_LOOKUP=1

# LLM-proposed relation rules need approval. Set e.g. 0.95 to auto-apply very confident ones; empty = always manual.
RULE_AUTO_THRESHOLD=
# Extracted facts below this confidence go to the review queue instead of the graph.
MIN_TRIPLE_CONFIDENCE=0.6
